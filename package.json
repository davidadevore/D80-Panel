{
  "name": "d80-panel",
  "version": "0.1.0",
  "description": "Read-only mobile/web fleet dashboard for d&b audiotechnik amplifiers (D80, D40, ...) over OCA/AES70",
  "main": "server.js",
  "type": "module",
  "license": "MIT",
  "author": "Devore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidadevore/d80-panel.git"
  },
  "homepage": "https://github.com/davidadevore/d80-panel#readme",
